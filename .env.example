# Copia este archivo a .env y completa los valores.
# Solo variables PÚBLICAS: la anon key de Supabase está pensada para el cliente (protegida por RLS).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Se llena con `npx eas-cli init`
EAS_PROJECT_ID=
# Opcional: número del equipo (9 dígitos) para que los contactos demo abran un WhatsApp real
EXPO_PUBLIC_DEMO_WHATSAPP=
